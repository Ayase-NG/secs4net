<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Secs4Net.Flows.Sgrs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 客制化代码直接引用 Secs4Net（例如 SecsMessage），与 Flows 库并列，避免仅通过传递引用解析类型 -->
    <ProjectReference Include="..\Secs4Net\Secs4Net.csproj" />
    <ProjectReference Include="..\Secs4Net.Flows\Secs4Net.Flows.csproj" />
  </ItemGroup>

</Project>
