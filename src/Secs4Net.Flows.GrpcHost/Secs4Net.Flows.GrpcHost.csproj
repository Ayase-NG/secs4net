<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Secs4Net.Flows.GrpcHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.62.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Secs4Net\Secs4Net.csproj" />
    <ProjectReference Include="..\Secs4Net.Sml\Secs4Net.Sml.csproj" />
    <ProjectReference Include="..\Secs4Net.Flows\Secs4Net.Flows.csproj" />
    <ProjectReference Include="..\Secs4Net.Flows.Sgrs\Secs4Net.Flows.Sgrs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\flow_bridge.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
